    {
      "id": "B3Hl_CFliN4pFGzUfrO_S",
      "type": "text",
      "x": 178.3532365077176,
      "y": 835.1850624109838,
      "width": 561.3196411132812,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3Z",
      "roundness": null,
      "seed": 262558760,
      "version": 740,
      "versionNonce": 1295579244,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786358239872,
      "link": null,
      "locked": false,
      "text": "Evaluate(M, Obs):\n    exp_trajectory <-- Run obs.plan on obs.S0 assuming M\n    return #mismatches between exp_trajectory and Obs\n\nLearn(all_trajectories):\n    M_best<--none\n    min_v = infinity\n    While True // or some other stop criteria\n        T<--sample next trajectories from all_trajectories\n        T'<-- MILP(M_best, T)\n        M <-- pisam(T') \n        V(M)<-- evaluate(M, all_trajectories)\n        if V(M)<min_v\n            min_v<-- V(M)\n            M_best= M\n    return M",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Evaluate(M, Obs):\n    exp_trajectory <-- Run obs.plan on obs.S0 assuming M\n    return #mismatches between exp_trajectory and Obs\n\nLearn(all_trajectories):\n    M_best<--none\n    min_v = infinity\n    While True // or some other stop criteria\n        T<--sample next trajectories from all_trajectories\n        T'<-- MILP(M_best, T)\n        M <-- pisam(T') \n        V(M)<-- evaluate(M, all_trajectories)\n        if V(M)<min_v\n            min_v<-- V(M)\n            M_best= M\n    return M",
      "autoResize": true,
      "lineHeight": 1.25
    },
